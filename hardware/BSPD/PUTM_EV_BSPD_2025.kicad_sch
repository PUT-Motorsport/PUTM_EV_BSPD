	(text "Comparators Logic\n"
		(exclude_from_sim no)
		(at 73.914 109.474 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "f45ca3e4-bcaf-4cce-bfa2-40b3f9cb76d0")
	)
	(text "Whenever the \"Error\" state goes to low, the comparator timer goes low, \nsending a trailing edge to the trigger, pulling the output to low and\nstarting a countdown to reset the SDC Relay.\n\nThe 500ms RC is simultaneously used as a filter of input rippling."
		(exclude_from_sim no)
		(at 151.13 162.052 0)
		(effects
			(font
				(size 0.635 0.635)
				(italic yes)
				(color 168 168 168 1)
			)
		)
		(uuid "fa750405-7580-4580-9630-1d4ddee3a9a8")
	)
